[Unit]
Description=Solitary Traveler admin service
After=network.target

[Service]
Type=simple
User=solitary-traveler
Group=solitary-traveler
WorkingDirectory=/opt/solitary-traveler
EnvironmentFile=/etc/solitary-traveler/admin.env
ExecStart=/usr/bin/node /opt/solitary-traveler/admin/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/solitary-traveler /var/www/solitary-traveler /opt/solitary-traveler

[Install]
WantedBy=multi-user.target
